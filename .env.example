# .env.example
# Copy this file to .env.local for local development
# Then add these same variables in your Vercel dashboard under Settings → Environment Variables

# From console.anthropic.com → API Keys
# NOTE: This goes in Vercel as ANTHROPIC_API_KEY (no VITE_ prefix — kept server-side only)
ANTHROPIC_API_KEY=sk-ant-...

# From app.supabase.com → Your Project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# From console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# GOOGLE_CLIENT_ID and VITE_GOOGLE_CLIENT_ID should be the SAME value (one for server, one for client)
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
GOOGLE_REDIRECT_URI=http://localhost:5173/oauth/callback
VITE_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
